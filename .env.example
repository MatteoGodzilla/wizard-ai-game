# Copy to .env next to project.godot or the Windows executable.
# Environment variables override values in this file.
WORKSHOP_PROVIDER=openrouter
WORKSHOP_MODEL=openrouter/free
SPELLCHECK_PROVIDER=ollama
SPELLCHECK_MODEL=gemma3:4b
SPELLCHECK_OLLAMA_PORT=11435

# Use matching model IDs when selecting openrouter, google, or groq.
# Supply only keys for the hosted providers you use.
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
